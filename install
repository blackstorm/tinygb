#!/usr/bin/env sh

set -eu

bin="gobackup"
dest_dir="/usr/local/bin"
version="${1:-dev}"

if ! command -v go >/dev/null 2>&1; then
  echo "go: not found"
  exit 1
fi

if ! command -v pnpm >/dev/null 2>&1; then
  if command -v corepack >/dev/null 2>&1; then
    corepack enable
  else
    echo "pnpm: not found"
    exit 1
  fi
fi

root_dir="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
cd "${root_dir}"

(
  cd web
  pnpm install --frozen-lockfile
  pnpm build
)

CGO_ENABLED=0 go build -ldflags="-s -w -X main.version=${version}" -o "${bin}" .

if test "$(id -u)" -eq 0; then
  mv "${bin}" "${dest_dir}/${bin}"
else
  sudo mv "${bin}" "${dest_dir}/${bin}"
fi

mkdir -p ~/.gobackup

echo "${bin} ${version} has been installed."
